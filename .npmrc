# Flat node_modules (npm-style). Fixes Turbopack failing to resolve transitive
# radix-ui deps of @mysten/dapp-kit under pnpm's symlinked store.
# shamefully-hoist forces ALL deps (incl. next/node_modules/react) to root,
# fixing the duplicate React SSR crash on Vercel.
node-linker=hoisted
shamefully-hoist=true
strict-peer-dependencies=false
