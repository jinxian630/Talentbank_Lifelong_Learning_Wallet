# =============================================================================
# apps/web/.env.local
# =============================================================================

# Firebase — web app (get from Firebase Console > Project Settings > Your Apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=



# Sui Testnet — talentbank_badge contract addresses
NEXT_PUBLIC_SUI_PACKAGE_ID=
NEXT_PUBLIC_SUI_REGISTRY_ID=
NEXT_PUBLIC_SUI_ADMIN_CAP_ID=

# Deployer wallet private key — server-side only, never expose to browser
# Export from Sui CLI: sui keytool export --key-identity <address>
SUI_ADMIN_PRIVATE_KEY=

# =============================================================================
# apps/mobile/.env
# =============================================================================

# Firebase — mobile app (same project values, Expo prefix)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth client IDs (Google Cloud Console > APIs & Services > Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Web app base URL for badge claim page
# Dev: use your machine's LAN IP (e.g. http://192.168.1.x:3000)
# Prod: your deployed domain
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Sui Testnet — talentbank_badge contract addresses
EXPO_PUBLIC_SUI_PACKAGE_ID=
EXPO_PUBLIC_SUI_REGISTRY_ID=
