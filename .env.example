# =============================================================================
# apps/web/.env.local
# =============================================================================

# Firebase — web app (get from Firebase Console > Project Settings > Your Apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Azure AI Foundry — gpt-4o-mini (powers chat + badge-design/event-fill/feedback-digest agents)
# Endpoint MUST end with /openai/v1
AZURE_FOUNDRY_ENDPOINT=https://<resource>.openai.azure.com/openai/v1
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=gpt-4o-mini

# Python RAG sidecar (services/ai). Chat route falls back to direct Azure if unreachable.
AI_SERVICE_URL=http://localhost:8000

# Sui Testnet — talentbank_badge contract addresses (see packages/contracts/badge/deployed.json)
NEXT_PUBLIC_SUI_PACKAGE_ID=
NEXT_PUBLIC_SUI_REGISTRY_ID=
NEXT_PUBLIC_SUI_ADMIN_CAP_ID=

# Deployer wallet private key — server-side only, never expose to browser
# Export from Sui CLI: sui keytool export --key-identity <address>
SUI_ADMIN_PRIVATE_KEY=

# =============================================================================
# apps/mobile/.env
# =============================================================================

# Firebase — mobile app (same project values, Expo prefix)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth client IDs (Google Cloud Console > APIs & Services > Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Web API base URL — used for AI recommendations proxy + badge claim page
# Dev: use your machine's LAN IP for physical device (e.g. http://192.168.1.x:3000)
# Prod: your deployed web domain
EXPO_PUBLIC_API_URL=http://localhost:3000

# Sui Testnet — talentbank_badge contract addresses (see packages/contracts/badge/deployed.json)
EXPO_PUBLIC_SUI_PACKAGE_ID=
EXPO_PUBLIC_SUI_REGISTRY_ID=

# =============================================================================
# services/ai/.env  (Python RAG sidecar — copy from services/ai/.env.example)
# =============================================================================

# Azure AI Foundry — base endpoint WITHOUT /openai/v1 suffix (sidecar appends it)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# Firebase Admin SDK key — download from Console > Service Accounts, save in services/ai/
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
AI_SERVICE_PORT=8000
