rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isApprovedAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'approved';
    }

    // ─── EVENTS ────────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read:           if request.auth != null;
      allow create, delete: if isApprovedAdmin();
      allow update:         if request.auth != null;
    }

    // ─── ADMINS ────────────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read:   if request.auth != null;
      allow create: if request.auth.uid == uid;
      allow update: if isApprovedAdmin();
    }

    // ─── BADGES ────────────────────────────────────────────────────────────────
    // Users can create their own badges (e.g. cert enrollment award)
    match /badges/{badgeId} {
      allow read:           if request.auth != null;
      allow create:         if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isApprovedAdmin();
    }

    // ─── USER SALTS (ZK Login — Cloud Function access only) ───────────────────
    match /userSalts/{uid} {
      allow read, write: if false;
    }

    // ─── USERS ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth.uid == uid;

      match /xpLogs/{logId} {
        allow read:   if request.auth.uid == uid;
        allow create: if request.auth != null;
      }

      match /savedCerts/{certId} {
        allow read, write: if request.auth.uid == uid;
      }

      match /enrollments/{certId} {
        allow read, write: if request.auth.uid == uid;
      }

      match /certPreferences/{docId} {
        allow read, write: if request.auth.uid == uid;
      }
    }

    // ─── FEEDBACK ──────────────────────────────────────────────────────────────
    match /feedback/{docId} {
      allow read:   if isApprovedAdmin();
      allow create: if request.auth != null;
    }

    // ─── CERT EXAMS (XP-gated internal exams) ──────────────────────────────────
    match /certExams/{examId} {
      allow read:           if request.auth != null;
      allow create, delete: if isApprovedAdmin();
      allow update:         if request.auth != null;
    }

    // ─── EXAM REGISTRATIONS ────────────────────────────────────────────────────
    match /examRegistrations/{regId} {
      allow read:   if request.auth.uid == resource.data.userId || isApprovedAdmin();
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;
      allow update: if isApprovedAdmin();
    }

    // ─── CERTS (Cert Market — external professional certifications) ─────────────
    match /certs/{certId} {
      allow read:           if request.auth != null;
      allow create, delete: if isApprovedAdmin();
      allow update:         if isApprovedAdmin();
    }

  }
}
